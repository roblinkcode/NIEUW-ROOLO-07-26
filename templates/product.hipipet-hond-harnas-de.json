    "custom_liquid_pW4hN9": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign hipipet_video = 'https://cdn.shopify.com/videos/c/o/v/d12f5ef4ef66408194dfa4637f5af0b6.mp4' %}\n\n<section class=\"hipipet-how\">\n  <div class=\"hipipet-how__inner\">\n\n    <!-- VIDEO -->\n    <div class=\"hipipet-how__video-wrap\">\n\n      <video\n        class=\"hipipet-how__video\"\n        autoplay\n        muted\n        loop\n        playsinline\n        preload=\"metadata\"\n        disablepictureinpicture\n        controlslist=\"nodownload noplaybackrate noremoteplayback\"\n      >\n        <source src=\"{{ hipipet_video }}\" type=\"video/mp4\">\n      </video>\n\n    </div>\n\n\n    <!-- TEXT -->\n    <div class=\"hipipet-how__content\">\n\n      <span class=\"hipipet-how__eyebrow\">\n        SO FUNKTIONIERT HIPIPET\n      </span>\n\n      <h2>\n        Vom Spazieren zum Tragen<br>\n        in wenigen Sekunden\n      </h2>\n\n      <p class=\"hipipet-how__intro\">\n        HIPIPET bleibt beim Spazierengehen einfach am Hund.\n        Wird dein Hund müde? Dann hebst du ihn einfach hoch oder befestigst den Schultergurt.\n      </p>\n\n\n      <div class=\"hipipet-how__steps\">\n\n        <!-- SCHRITT 1 -->\n        <div class=\"hipipet-how__step\">\n          <span class=\"hipipet-how__number\">1</span>\n\n          <div>\n            <strong>HIPIPET anlegen</strong>\n            <p>\n              Setze deinen Hund bequem in das Geschirr und schließe den Verschluss sicher.\n            </p>\n          </div>\n        </div>\n\n\n        <!-- SCHRITT 2 -->\n        <div class=\"hipipet-how__step\">\n          <span class=\"hipipet-how__number\">2</span>\n\n          <div>\n            <strong>Spazieren oder direkt anheben</strong>\n            <p>\n              Lass deinen Hund ganz normal mitlaufen oder nutze die Handgriffe, wenn du ihn tragen möchtest.\n            </p>\n          </div>\n        </div>\n\n\n        <!-- SCHRITT 3 -->\n        <div class=\"hipipet-how__step\">\n          <span class=\"hipipet-how__number\">3</span>\n\n          <div>\n            <strong>Schultergurt befestigen</strong>\n            <p>\n              Befestige den verstellbaren Gurt und trage deinen Hund bequem über der Schulter.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n\n      <div class=\"hipipet-how__bottom\">\n        <span class=\"hipipet-how__check\">✓</span>\n\n        <span>\n          Keine separate Tragetasche nötig — Spazieren und Tragen mit demselben Geschirr.\n        </span>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n\n  /* SEKTION */\n\n  .hipipet-how {\n    width: 100%;\n    box-sizing: border-box;\n\n    background: #ffffff;\n\n    padding: 54px 20px;\n  }\n\n  .hipipet-how__inner {\n    width: 100%;\n    max-width: 1120px;\n\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);\n\n    gap: 52px;\n    align-items: center;\n  }\n\n\n  /* VIDEO */\n\n  .hipipet-how__video-wrap {\n    position: relative;\n\n    width: 100%;\n    overflow: hidden;\n\n    background: #f3eee9;\n\n    border: 1px solid #eee3da;\n    border-radius: 18px;\n\n    box-shadow: 0 10px 32px rgba(70, 45, 30, 0.07);\n  }\n\n  .hipipet-how__video {\n    display: block;\n\n    width: 100%;\n    height: auto;\n\n    max-height: 570px;\n\n    object-fit: cover;\n\n    background: #f3eee9;\n  }\n\n\n  /* CONTENT */\n\n  .hipipet-how__content {\n    width: 100%;\n    max-width: 500px;\n  }\n\n  .hipipet-how__eyebrow {\n    display: inline-flex;\n    align-items: center;\n\n    padding: 6px 11px;\n    margin-bottom: 14px;\n\n    background: #f1e5db;\n    color: #8d5d3f;\n\n    border-radius: 999px;\n\n    font-size: 10px;\n    line-height: 1;\n\n    font-weight: 800;\n    letter-spacing: 0.7px;\n  }\n\n  .hipipet-how__content h2 {\n    margin: 0 0 14px;\n\n    color: #2d2723;\n\n    font-size: clamp(30px, 3vw, 43px);\n    line-height: 1.07;\n\n    font-weight: 700;\n    letter-spacing: -1px;\n  }\n\n  .hipipet-how__intro {\n    margin: 0 0 24px;\n\n    color: #665b53;\n\n    font-size: 13.5px;\n    line-height: 1.58;\n\n    font-weight: 500;\n  }\n\n\n  /* SCHRITTE */\n\n  .hipipet-how__steps {\n    display: grid;\n    gap: 14px;\n  }\n\n  .hipipet-how__step {\n    display: flex;\n    align-items: flex-start;\n\n    gap: 12px;\n  }\n\n  .hipipet-how__number {\n    width: 29px;\n    height: 29px;\n\n    flex: 0 0 29px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 50%;\n\n    background: #9a6645;\n    color: #ffffff;\n\n    font-size: 11px;\n    font-weight: 800;\n  }\n\n  .hipipet-how__step strong {\n    display: block;\n\n    margin-bottom: 3px;\n\n    color: #342c27;\n\n    font-size: 13px;\n    line-height: 1.25;\n\n    font-weight: 750;\n  }\n\n  .hipipet-how__step p {\n    margin: 0;\n\n    color: #766960;\n\n    font-size: 11.2px;\n    line-height: 1.42;\n\n    font-weight: 500;\n  }\n\n\n  /* HINWEIS UNTEN */\n\n  .hipipet-how__bottom {\n    display: flex;\n    align-items: center;\n\n    gap: 8px;\n\n    margin-top: 23px;\n    padding: 11px 13px;\n\n    background: #faf7f3;\n\n    border: 1px solid #eadfd5;\n    border-radius: 10px;\n\n    color: #66584f;\n\n    font-size: 11.2px;\n    line-height: 1.4;\n\n    font-weight: 600;\n  }\n\n  .hipipet-how__check {\n    width: 19px;\n    height: 19px;\n\n    flex: 0 0 19px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: #f1e5db;\n    color: #956244;\n\n    border-radius: 50%;\n\n    font-size: 10px;\n    font-weight: 900;\n  }\n\n\n  /* MOBIL */\n\n  @media screen and (max-width: 749px) {\n\n    .hipipet-how {\n      padding: 28px 14px 30px;\n    }\n\n    .hipipet-how__inner {\n      display: flex;\n      flex-direction: column;\n\n      gap: 21px;\n    }\n\n    .hipipet-how__video-wrap {\n      width: 100%;\n\n      border-radius: 12px;\n    }\n\n    .hipipet-how__video {\n      max-height: none;\n    }\n\n    .hipipet-how__content {\n      width: 100%;\n      max-width: none;\n    }\n\n    .hipipet-how__eyebrow {\n      padding: 5px 9px;\n      margin-bottom: 10px;\n\n      font-size: 9px;\n    }\n\n    .hipipet-how__content h2 {\n      margin-bottom: 10px;\n\n      font-size: 25px;\n      line-height: 1.08;\n\n      letter-spacing: -0.5px;\n    }\n\n    .hipipet-how__intro {\n      margin-bottom: 18px;\n\n      font-size: 12px;\n      line-height: 1.48;\n    }\n\n    .hipipet-how__steps {\n      gap: 11px;\n    }\n\n    .hipipet-how__step {\n      gap: 9px;\n    }\n\n    .hipipet-how__number {\n      width: 24px;\n      height: 24px;\n\n      flex-basis: 24px;\n\n      font-size: 9.5px;\n    }\n\n    .hipipet-how__step strong {\n      font-size: 11.7px;\n    }\n\n    .hipipet-how__step p {\n      font-size: 10.5px;\n      line-height: 1.35;\n    }\n\n    .hipipet-how__bottom {\n      margin-top: 17px;\n\n      padding: 9px 10px;\n\n      background: #faf7f3;\n\n      font-size: 10.3px;\n    }\n\n  }\n\n</style>\n\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n\n    const hipipetVideos = document.querySelectorAll('.hipipet-how__video');\n\n    hipipetVideos.forEach(function(video) {\n\n      /* Ton dauerhaft ausgeschaltet */\n      video.muted = true;\n      video.volume = 0;\n\n      /* Autoplay */\n      const playPromise = video.play();\n\n      if (playPromise !== undefined) {\n        playPromise.catch(function() {\n          /* Autoplay kann von einigen Browsern blockiert werden */\n        });\n      }\n\n      /* Ton dauerhaft ausgeschaltet lassen */\n      video.addEventListener('volumechange', function () {\n\n        if (!video.muted || video.volume !== 0) {\n          video.muted = true;\n          video.volume = 0;\n        }\n\n      });\n\n    });\n\n  });\n</script>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_c3dMgq": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign hipipet_size_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/HIPIPET_maattabel_DE.png?v=1788510030' %}\n\n<section class=\"hipipet-size-section\">\n  <div class=\"hipipet-size-inner\">\n\n    <!-- TEXT -->\n    <div class=\"hipipet-size-content\">\n\n      <span class=\"hipipet-size-eyebrow\">\n        DIE RICHTIGE PASSFORM\n      </span>\n\n      <h2>\n        Welche Größe passt<br>\n        zu deinem Hund?\n      </h2>\n\n      <p>\n        Miss den <strong>Brustumfang und Halsumfang</strong> deines Hundes\n        und vergleiche die Maße mit der Größentabelle.\n      </p>\n\n      <div class=\"hipipet-size-points\">\n\n        <div class=\"hipipet-size-point\">\n          <span class=\"hipipet-size-icon\">1</span>\n\n          <div>\n            <strong>Brust & Hals messen</strong>\n            <span>Miss deinen Hund entspannt und nicht zu eng.</span>\n          </div>\n        </div>\n\n        <div class=\"hipipet-size-point\">\n          <span class=\"hipipet-size-icon\">2</span>\n\n          <div>\n            <strong>Mit der Tabelle vergleichen</strong>\n            <span>Das Gewicht dient nur als zusätzliche Orientierung.</span>\n          </div>\n        </div>\n\n        <div class=\"hipipet-size-point\">\n          <span class=\"hipipet-size-icon\">3</span>\n\n          <div>\n            <strong>Zwischen zwei Größen?</strong>\n            <span>Wähle für zusätzlichen Komfort die größere Größe.</span>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"hipipet-size-note\">\n        <span class=\"hipipet-size-note-heart\">♥</span>\n\n        <span>\n          Eine gute Passform gibt deinem Hund ausreichend Bewegungsfreiheit\n          sowohl beim <strong>Spazierengehen als auch beim Tragen.</strong>\n        </span>\n      </div>\n\n      <!-- HILFE BEI DER GRÖSSENWAHL -->\n      <div class=\"hipipet-size-help\">\n        <div class=\"hipipet-size-help__icon\">?</div>\n\n        <div class=\"hipipet-size-help__content\">\n          <strong>Hilfe bei der Größenwahl?</strong>\n\n          <span>\n            Wir helfen dir gerne, die richtige Größe zu finden.\n            <a href=\"/pages/contact\">Kontaktiere uns</a>\n            oder schreibe uns an\n            <a href=\"mailto:info@roolo.de\">info@roolo.de</a>.\n          </span>\n        </div>\n      </div>\n\n    </div>\n\n\n    <!-- GRÖSSENTABELLE -->\n    <div class=\"hipipet-size-media\">\n      <img\n        src=\"{{ hipipet_size_image }}\"\n        alt=\"HIPIPET Größentabelle für kleine Hunde\"\n        loading=\"lazy\"\n      >\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n  .hipipet-size-section {\n    width: 100%;\n    box-sizing: border-box;\n\n    background: #faf7f3;\n\n    padding: 56px 20px;\n  }\n\n  .hipipet-size-inner {\n    width: 100%;\n    max-width: 1180px;\n\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);\n\n    align-items: center;\n\n    gap: 55px;\n  }\n\n\n  /* TEXT */\n\n  .hipipet-size-content {\n    width: 100%;\n    max-width: 445px;\n  }\n\n  .hipipet-size-eyebrow {\n    display: inline-flex;\n    align-items: center;\n\n    padding: 6px 11px;\n    margin-bottom: 14px;\n\n    background: #f1e5db;\n    color: #8d5d3f;\n\n    border-radius: 999px;\n\n    font-size: 10.5px;\n    line-height: 1;\n\n    font-weight: 800;\n    letter-spacing: 0.7px;\n  }\n\n  .hipipet-size-content h2 {\n    margin: 0 0 15px;\n\n    color: #2d2723;\n\n    font-size: clamp(31px, 3vw, 44px);\n    line-height: 1.06;\n\n    font-weight: 700;\n    letter-spacing: -1px;\n  }\n\n  .hipipet-size-content > p {\n    margin: 0 0 23px;\n\n    color: #655a52;\n\n    font-size: 14px;\n    line-height: 1.55;\n    font-weight: 500;\n  }\n\n  .hipipet-size-content > p strong {\n    color: #342b25;\n    font-weight: 750;\n  }\n\n\n  /* SCHRITTE */\n\n  .hipipet-size-points {\n    display: grid;\n    gap: 12px;\n  }\n\n  .hipipet-size-point {\n    display: flex;\n    align-items: flex-start;\n\n    gap: 11px;\n  }\n\n  .hipipet-size-icon {\n    width: 27px;\n    height: 27px;\n\n    flex: 0 0 27px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: #ead8c9;\n    color: #956244;\n\n    border-radius: 50%;\n\n    font-size: 11px;\n    font-weight: 900;\n  }\n\n  .hipipet-size-point div {\n    display: grid;\n    gap: 2px;\n  }\n\n  .hipipet-size-point strong {\n    color: #332b26;\n\n    font-size: 13px;\n    line-height: 1.3;\n\n    font-weight: 750;\n  }\n\n  .hipipet-size-point div span {\n    color: #74675e;\n\n    font-size: 11.5px;\n    line-height: 1.4;\n\n    font-weight: 500;\n  }\n\n\n  /* PASSFORM-HINWEIS */\n\n  .hipipet-size-note {\n    display: flex;\n    align-items: flex-start;\n\n    gap: 9px;\n\n    margin-top: 23px;\n    padding: 12px 13px;\n\n    background: #ffffff;\n\n    border: 1px solid #eadfd5;\n    border-radius: 10px;\n\n    color: #6b5d53;\n\n    font-size: 11.2px;\n    line-height: 1.45;\n\n    font-weight: 550;\n  }\n\n  .hipipet-size-note strong {\n    color: #4c3c31;\n    font-weight: 750;\n  }\n\n  .hipipet-size-note-heart {\n    color: #9a6645;\n\n    flex: 0 0 auto;\n\n    font-size: 13px;\n    line-height: 1.3;\n  }\n\n\n  /* HILFE BEI DER GRÖSSENWAHL */\n\n  .hipipet-size-help {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n\n    margin-top: 10px;\n    padding: 12px 13px;\n\n    background: #ffffff;\n\n    border: 1px solid #eadfd5;\n    border-radius: 10px;\n\n    color: #6b5d53;\n  }\n\n  .hipipet-size-help__icon {\n    width: 23px;\n    height: 23px;\n\n    flex: 0 0 23px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: #f1e5db;\n    color: #956244;\n\n    border-radius: 50%;\n\n    font-size: 11px;\n    font-weight: 900;\n  }\n\n  .hipipet-size-help__content {\n    display: grid;\n    gap: 2px;\n  }\n\n  .hipipet-size-help__content strong {\n    color: #3e332c;\n\n    font-size: 11.7px;\n    line-height: 1.3;\n\n    font-weight: 750;\n  }\n\n  .hipipet-size-help__content span {\n    color: #74675e;\n\n    font-size: 10.8px;\n    line-height: 1.45;\n\n    font-weight: 500;\n  }\n\n  .hipipet-size-help__content a {\n    color: #8d5d3f;\n\n    text-decoration: underline;\n    text-underline-offset: 2px;\n\n    font-weight: 700;\n  }\n\n  .hipipet-size-help__content a:hover {\n    color: #68422e;\n  }\n\n\n  /* GRÖSSENTABELLE */\n\n  .hipipet-size-media {\n    width: 100%;\n\n    overflow: hidden;\n\n    background: #ffffff;\n\n    border: 1px solid #eee3da;\n    border-radius: 16px;\n\n    box-shadow: 0 8px 28px rgba(70, 45, 30, 0.05);\n  }\n\n  .hipipet-size-media img {\n    display: block;\n\n    width: 100%;\n    height: auto;\n  }\n\n\n  /* TABLET */\n\n  @media screen and (max-width: 989px) {\n    .hipipet-size-inner {\n      gap: 32px;\n    }\n\n    .hipipet-size-content h2 {\n      font-size: 31px;\n    }\n  }\n\n\n  /* MOBIL */\n\n  @media screen and (max-width: 749px) {\n\n    .hipipet-size-section {\n      padding: 29px 14px 31px;\n    }\n\n    .hipipet-size-inner {\n      display: flex;\n      flex-direction: column;\n\n      gap: 20px;\n    }\n\n    .hipipet-size-content {\n      width: 100%;\n      max-width: none;\n    }\n\n    .hipipet-size-eyebrow {\n      padding: 5px 9px;\n      margin-bottom: 10px;\n\n      font-size: 9px;\n    }\n\n    .hipipet-size-content h2 {\n      margin-bottom: 10px;\n\n      font-size: 26px;\n      line-height: 1.07;\n\n      letter-spacing: -0.6px;\n    }\n\n    .hipipet-size-content > p {\n      margin-bottom: 17px;\n\n      font-size: 12.3px;\n      line-height: 1.45;\n    }\n\n    .hipipet-size-points {\n      gap: 9px;\n    }\n\n    .hipipet-size-point {\n      gap: 8px;\n    }\n\n    .hipipet-size-icon {\n      width: 23px;\n      height: 23px;\n\n      flex-basis: 23px;\n\n      font-size: 10px;\n    }\n\n    .hipipet-size-point strong {\n      font-size: 11.8px;\n    }\n\n    .hipipet-size-point div span {\n      font-size: 10.7px;\n      line-height: 1.35;\n    }\n\n    .hipipet-size-note {\n      gap: 7px;\n\n      margin-top: 17px;\n      padding: 10px 11px;\n\n      font-size: 10.5px;\n    }\n\n    .hipipet-size-help {\n      gap: 8px;\n\n      margin-top: 9px;\n      padding: 10px 11px;\n\n      border-radius: 9px;\n    }\n\n    .hipipet-size-help__icon {\n      width: 21px;\n      height: 21px;\n\n      flex-basis: 21px;\n\n      font-size: 10px;\n    }\n\n    .hipipet-size-help__content strong {\n      font-size: 10.8px;\n    }\n\n    .hipipet-size-help__content span {\n      font-size: 10px;\n      line-height: 1.4;\n    }\n\n    .hipipet-size-media {\n      border-radius: 11px;\n    }\n\n  }\n</style>",
