    "custom_liquid_j3t8Ac": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"hipipet-faq\">\n  <div class=\"hipipet-faq__inner\">\n\n    <div class=\"hipipet-faq__header\">\n      <span class=\"hipipet-faq__eyebrow\">HÄUFIG GESTELLTE FRAGEN</span>\n\n      <h2>Alles, was du über HIPIPET wissen möchtest</h2>\n\n      <p>\n        Von der richtigen Größe bis zum Spazierengehen und Tragen — hier findest du die wichtigsten Antworten.\n      </p>\n    </div>\n\n\n    <div class=\"hipipet-faq__list\">\n\n      <!-- FAQ 1 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Wie funktioniert HIPIPET genau?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          HIPIPET ist eine 2-in-1 Kombination aus Geschirr und Tragehilfe.\n          Dein Hund kann damit ganz normal spazierengehen. Wenn dein Hund müde wird,\n          nutzt du die Handgriffe oder befestigst den verstellbaren Schultergurt,\n          um ihn bequem weiterzutragen.\n        </div>\n      </details>\n\n\n      <!-- FAQ 2 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Kann mein Hund damit ganz normal spazierengehen?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          Ja. HIPIPET wurde so entwickelt, dass dein kleiner Hund beim Spaziergang\n          ganz normal mitlaufen kann. Du musst also nicht ständig zwischen einem\n          separaten Geschirr und einer Tragetasche wechseln.\n        </div>\n      </details>\n\n\n      <!-- FAQ 3 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Für welche Hunde ist HIPIPET geeignet?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          HIPIPET ist für kleine Hunde geeignet. Die verfügbaren Größen reichen\n          von S bis XL. Achte vor allem auf den Brust- und Halsumfang deines Hundes;\n          das Gewicht dient lediglich als zusätzliche Orientierung.\n        </div>\n      </details>\n\n\n      <!-- FAQ 4 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Welche Größe sollte ich wählen?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          Miss den Brust- und Halsumfang deines Hundes und vergleiche die Maße\n          mit unserer Größentabelle. Liegt dein Hund zwischen zwei Größen?\n          Wähle dann am besten die größere Größe für etwas mehr Bewegungsfreiheit.\n        </div>\n      </details>\n\n\n      <!-- FAQ 5 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Ist HIPIPET beim Tragen bequem?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          Die Form unterstützt den Körper in einer horizontalen Position und\n          die Beinöffnungen bieten ausreichend Bewegungsfreiheit. Achte immer\n          darauf, dass die gewählte Größe gut sitzt und alle Befestigungen\n          korrekt geschlossen sind.\n        </div>\n      </details>\n\n\n      <!-- FAQ 6 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Wie kann ich meinen Hund tragen?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          Mit den kurzen Handgriffen kannst du deinen Hund schnell und einfach\n          anheben. Für längere Strecken kannst du den verstellbaren Gurt\n          befestigen und HIPIPET bequem über der Schulter tragen.\n        </div>\n      </details>\n\n\n      <!-- FAQ 7 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Welche Farben sind erhältlich?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          HIPIPET ist in zwei Farben erhältlich: Weiß mit braunen Details\n          und komplett Schwarz.\n        </div>\n      </details>\n\n\n      <!-- FAQ 8 -->\n      <details class=\"hipipet-faq__item\">\n        <summary>\n          <span>Was erhalte ich mit meiner Bestellung?</span>\n          <span class=\"hipipet-faq__plus\"></span>\n        </summary>\n\n        <div class=\"hipipet-faq__answer\">\n          Du erhältst das HIPIPET Tragegeschirr inklusive des verstellbaren\n          Schultergurts und der dazugehörigen Befestigungen.\n        </div>\n      </details>\n\n    </div>\n\n\n    <div class=\"hipipet-faq__help\">\n      <div class=\"hipipet-faq__help-icon\">♥</div>\n\n      <div>\n        <strong>Noch nicht ganz sicher?</strong>\n        <span>\n          Schau dir die Größentabelle oben an oder kontaktiere uns, wenn du Hilfe bei der Auswahl benötigst.\n        </span>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n  .hipipet-faq {\n    width: 100%;\n    box-sizing: border-box;\n\n    background: #ffffff;\n\n    padding: 58px 20px 62px;\n  }\n\n  .hipipet-faq__inner {\n    width: 100%;\n    max-width: 900px;\n\n    margin: 0 auto;\n  }\n\n\n  /* HEADER */\n\n  .hipipet-faq__header {\n    text-align: center;\n\n    max-width: 650px;\n\n    margin: 0 auto 28px;\n  }\n\n  .hipipet-faq__eyebrow {\n    display: inline-flex;\n\n    padding: 6px 11px;\n    margin-bottom: 13px;\n\n    background: #f1e5db;\n    color: #8d5d3f;\n\n    border-radius: 999px;\n\n    font-size: 10px;\n    line-height: 1;\n\n    font-weight: 800;\n    letter-spacing: 0.7px;\n  }\n\n  .hipipet-faq__header h2 {\n    margin: 0 0 11px;\n\n    color: #2d2723;\n\n    font-size: clamp(29px, 3vw, 42px);\n    line-height: 1.08;\n\n    font-weight: 700;\n    letter-spacing: -0.9px;\n  }\n\n  .hipipet-faq__header p {\n    margin: 0;\n\n    color: #75685f;\n\n    font-size: 13px;\n    line-height: 1.5;\n    font-weight: 500;\n  }\n\n\n  /* FAQ LIST */\n\n  .hipipet-faq__list {\n    display: grid;\n    gap: 9px;\n  }\n\n  .hipipet-faq__item {\n    background: #faf7f3;\n\n    border: 1px solid #eadfd5;\n    border-radius: 11px;\n\n    overflow: hidden;\n\n    transition:\n      border-color .2s ease,\n      box-shadow .2s ease;\n  }\n\n  .hipipet-faq__item[open] {\n    border-color: #ddc9b9;\n\n    box-shadow: 0 5px 18px rgba(70, 45, 30, 0.045);\n  }\n\n  .hipipet-faq__item summary {\n    position: relative;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    gap: 20px;\n\n    padding: 16px 17px;\n\n    cursor: pointer;\n\n    list-style: none;\n\n    color: #342c27;\n\n    font-size: 13.2px;\n    line-height: 1.3;\n\n    font-weight: 750;\n  }\n\n  .hipipet-faq__item summary::-webkit-details-marker {\n    display: none;\n  }\n\n\n  /* PLUS / MINUS */\n\n  .hipipet-faq__plus {\n    position: relative;\n\n    width: 24px;\n    height: 24px;\n\n    flex: 0 0 24px;\n\n    border-radius: 50%;\n\n    background: #f1e5db;\n  }\n\n  .hipipet-faq__plus::before,\n  .hipipet-faq__plus::after {\n    content: \"\";\n\n    position: absolute;\n\n    top: 50%;\n    left: 50%;\n\n    width: 10px;\n    height: 1.5px;\n\n    background: #956244;\n\n    border-radius: 2px;\n\n    transform: translate(-50%, -50%);\n    transition: transform .2s ease;\n  }\n\n  .hipipet-faq__plus::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n\n  .hipipet-faq__item[open] .hipipet-faq__plus::after {\n    transform: translate(-50%, -50%) rotate(0deg);\n  }\n\n\n  /* ANTWORT */\n\n  .hipipet-faq__answer {\n    padding: 0 52px 17px 17px;\n\n    color: #6d6057;\n\n    font-size: 12.2px;\n    line-height: 1.55;\n\n    font-weight: 500;\n  }\n\n\n  /* HILFE BOX */\n\n  .hipipet-faq__help {\n    display: flex;\n    align-items: center;\n\n    gap: 11px;\n\n    margin-top: 23px;\n    padding: 14px 16px;\n\n    background: #f5ebe2;\n\n    border-radius: 11px;\n\n    color: #63544a;\n  }\n\n  .hipipet-faq__help-icon {\n    width: 31px;\n    height: 31px;\n\n    flex: 0 0 31px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 50%;\n\n    background: #ffffff;\n\n    color: #9a6645;\n\n    font-size: 12px;\n  }\n\n  .hipipet-faq__help div:last-child {\n    display: grid;\n    gap: 2px;\n  }\n\n  .hipipet-faq__help strong {\n    color: #3c3029;\n\n    font-size: 12px;\n    line-height: 1.3;\n\n    font-weight: 750;\n  }\n\n  .hipipet-faq__help span {\n    font-size: 10.8px;\n    line-height: 1.4;\n\n    font-weight: 500;\n  }\n\n\n  /* MOBIL */\n\n  @media screen and (max-width: 749px) {\n\n    .hipipet-faq {\n      padding: 34px 14px 38px;\n    }\n\n    .hipipet-faq__header {\n      margin-bottom: 21px;\n    }\n\n    .hipipet-faq__eyebrow {\n      padding: 5px 9px;\n      margin-bottom: 10px;\n\n      font-size: 9px;\n    }\n\n    .hipipet-faq__header h2 {\n      margin-bottom: 8px;\n\n      font-size: 25px;\n      line-height: 1.09;\n\n      letter-spacing: -0.5px;\n    }\n\n    .hipipet-faq__header p {\n      font-size: 11.5px;\n      line-height: 1.45;\n    }\n\n    .hipipet-faq__list {\n      gap: 7px;\n    }\n\n    .hipipet-faq__item {\n      border-radius: 9px;\n    }\n\n    .hipipet-faq__item summary {\n      gap: 13px;\n\n      padding: 13px 12px;\n\n      font-size: 11.8px;\n      line-height: 1.3;\n    }\n\n    .hipipet-faq__plus {\n      width: 21px;\n      height: 21px;\n\n      flex-basis: 21px;\n    }\n\n    .hipipet-faq__plus::before,\n    .hipipet-faq__plus::after {\n      width: 8px;\n    }\n\n    .hipipet-faq__answer {\n      padding: 0 42px 13px 12px;\n\n      font-size: 10.8px;\n      line-height: 1.48;\n    }\n\n    .hipipet-faq__help {\n      gap: 9px;\n\n      margin-top: 17px;\n      padding: 11px 12px;\n\n      border-radius: 9px;\n    }\n\n    .hipipet-faq__help-icon {\n      width: 27px;\n      height: 27px;\n\n      flex-basis: 27px;\n    }\n\n    .hipipet-faq__help strong {\n      font-size: 11px;\n    }\n\n    .hipipet-faq__help span {\n      font-size: 9.8px;\n    }\n\n  }\n</style>",
