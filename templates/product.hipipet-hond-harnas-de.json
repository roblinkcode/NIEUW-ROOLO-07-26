    "custom_liquid_k7dg8p": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign review_1_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipet_review.jpg?v=1787670906' %}\n{% assign review_2_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipet_revie_4.png?v=1787670910' %}\n{% assign review_3_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipet_review_3.png?v=1787670911' %}\n{% assign review_4_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/review_hipipet.png?v=1787670910' %}\n{% assign review_5_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipet_review_2.jpg?v=1787772955' %}\n\n<section class=\"hipipet-reviews\">\n  <div class=\"hipipet-reviews__inner\">\n\n    <div class=\"hipipet-reviews__header\">\n      <span class=\"hipipet-reviews__heart\">♥</span>\n      <h2>Geliebt von Hundehaltern & ihren Vierbeinern</h2>\n      <p>Echte Erfahrungen mit HIPIPET</p>\n    </div>\n\n    <div class=\"hipipet-reviews__wrap\">\n\n      <button\n        class=\"hipipet-reviews__arrow hipipet-reviews__arrow--left\"\n        type=\"button\"\n        aria-label=\"Vorherige Bewertungen\"\n      >\n        ‹\n      </button>\n\n      <div class=\"hipipet-reviews__track\" id=\"hipipetReviewsTrack\">\n\n        <!-- REVIEW 1 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n\n            <div class=\"hipipet-review-card__top\">\n              <strong>Gerda & Milo</strong>\n              <div class=\"hipipet-review-stars\">★★★★★</div>\n            </div>\n\n            <p>\n              „Super praktisch bei längeren Spaziergängen.\n              Wenn Milo müde wird, trage ich ihn einfach weiter.“\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Verifizierter Kauf\n            </span>\n\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n\n            {% if review_1_image != blank %}\n              <img\n                src=\"{{ review_1_image }}\"\n                alt=\"Gerda & Milo mit HIPIPET\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n\n          </div>\n        </article>\n\n\n        <!-- REVIEW 2 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n\n            <div class=\"hipipet-review-card__top\">\n              <strong>Lisa & Teddy</strong>\n              <div class=\"hipipet-review-stars\">★★★★★</div>\n            </div>\n\n            <p>\n              „Er kann ganz normal damit laufen und danach\n              hebe ich ihn mit einem Handgriff hoch. Einfach ideal.“\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Verifizierter Kauf\n            </span>\n\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n\n            {% if review_2_image != blank %}\n              <img\n                src=\"{{ review_2_image }}\"\n                alt=\"Lisa & Teddy mit HIPIPET\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n\n          </div>\n        </article>\n\n\n        <!-- REVIEW 3 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n\n            <div class=\"hipipet-review-card__top\">\n              <strong>Emma & Pippa</strong>\n              <div class=\"hipipet-review-stars\">★★★★★</div>\n            </div>\n\n            <p>\n              „Besonders in der Stadt und unterwegs nutzen\n              wir es oft. Pippa sitzt ganz entspannt darin.“\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Verifizierter Kauf\n            </span>\n\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n\n            {% if review_3_image != blank %}\n              <img\n                src=\"{{ review_3_image }}\"\n                alt=\"Emma & Pippa mit HIPIPET\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n\n          </div>\n        </article>\n\n\n        <!-- REVIEW 4 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n\n            <div class=\"hipipet-review-card__top\">\n              <strong>Noa & Lou</strong>\n              <div class=\"hipipet-review-stars\">★★★★★</div>\n            </div>\n\n            <p>\n              „Sieht viel schöner aus als eine normale\n              Hundetasche und fühlt sich überraschend stabil an.“\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Verifizierter Kauf\n            </span>\n\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n\n            {% if review_4_image != blank %}\n              <img\n                src=\"{{ review_4_image }}\"\n                alt=\"Noa & Lou mit HIPIPET\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n\n          </div>\n        </article>\n\n\n        <!-- REVIEW 5 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n\n            <div class=\"hipipet-review-card__top\">\n              <strong>Jordan & Max</strong>\n              <div class=\"hipipet-review-stars\">★★★★★</div>\n            </div>\n\n            <p>\n              „Bin super zufrieden mit HIPIPET. Es ist stabil\n              und mein Hund sitzt bequem darin.“\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Verifizierter Kauf\n            </span>\n\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n\n            {% if review_5_image != blank %}\n              <img\n                src=\"{{ review_5_image }}\"\n                alt=\"Jordan & Max mit HIPIPET\"\n                loading=\"lazy\"\n              >\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n\n          </div>\n        </article>\n\n      </div>\n\n\n      <button\n        class=\"hipipet-reviews__arrow hipipet-reviews__arrow--right\"\n        type=\"button\"\n        aria-label=\"Weitere Bewertungen\"\n      >\n        ›\n      </button>\n\n    </div>\n  </div>\n</section>\n\n\n<style>\n\n  .hipipet-reviews {\n    background: #faf7f3;\n    padding: 32px 0 36px;\n    overflow: hidden;\n  }\n\n  .hipipet-reviews__inner {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n\n  /* HEADER */\n\n  .hipipet-reviews__header {\n    text-align: center;\n    padding: 0 18px;\n    margin-bottom: 20px;\n  }\n\n  .hipipet-reviews__heart {\n    display: block;\n\n    color: #9a6645;\n\n    font-size: 15px;\n    line-height: 1;\n\n    margin-bottom: 6px;\n  }\n\n  .hipipet-reviews__header h2 {\n    margin: 0;\n\n    color: #2d2723;\n\n    font-size: 25px;\n    line-height: 1.15;\n\n    font-weight: 750;\n    letter-spacing: -0.4px;\n  }\n\n  .hipipet-reviews__header p {\n    margin: 5px 0 0;\n\n    color: #776a61;\n\n    font-size: 12px;\n    line-height: 1.3;\n  }\n\n\n  /* SLIDER */\n\n  .hipipet-reviews__wrap {\n    position: relative;\n  }\n\n  .hipipet-reviews__track {\n    display: flex;\n    gap: 13px;\n\n    overflow-x: auto;\n\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n\n    padding: 3px 55px 8px;\n\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .hipipet-reviews__track::-webkit-scrollbar {\n    display: none;\n  }\n\n\n  /* REVIEW CARD */\n\n  .hipipet-review-card {\n    flex: 0 0 355px;\n\n    height: 155px;\n\n    display: grid;\n    grid-template-columns: 1fr 120px;\n\n    background: #fffdfa;\n\n    border: 1px solid #eadfd5;\n    border-radius: 13px;\n\n    overflow: hidden;\n\n    scroll-snap-align: start;\n\n    box-shadow:\n      0 4px 16px rgba(70,45,30,0.035);\n  }\n\n\n  /* TEXT */\n\n  .hipipet-review-card__content {\n    padding: 13px 12px 11px 14px;\n\n    display: flex;\n    flex-direction: column;\n\n    min-width: 0;\n  }\n\n  .hipipet-review-card__top strong {\n    display: block;\n\n    color: #2d2723;\n\n    font-size: 12.5px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n\n  .hipipet-review-stars {\n    color: #a66d48;\n\n    letter-spacing: 1px;\n\n    font-size: 10px;\n    line-height: 1;\n\n    margin-top: 4px;\n  }\n\n  .hipipet-review-card__content p {\n    margin: 10px 0 8px;\n\n    color: #4f453e;\n\n    font-size: 11.6px;\n    line-height: 1.4;\n\n    font-weight: 500;\n  }\n\n  .hipipet-review-verified {\n    margin-top: auto;\n\n    color: #8b796d;\n\n    font-size: 9.5px;\n    line-height: 1;\n\n    font-weight: 600;\n  }\n\n\n  /* FOTO */\n\n  .hipipet-review-card__media {\n    width: 120px;\n    height: 155px;\n\n    overflow: hidden;\n\n    background: #f0e7de;\n  }\n\n  .hipipet-review-card__media img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hipipet-review-placeholder {\n    width: 100%;\n    height: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    color: #b59a87;\n\n    font-size: 11px;\n    font-weight: 700;\n\n    background:\n      linear-gradient(\n        135deg,\n        #f4ece5,\n        #eadfd5\n      );\n  }\n\n\n  /* PFEILE */\n\n  .hipipet-reviews__arrow {\n    position: absolute;\n\n    top: 50%;\n\n    z-index: 5;\n\n    width: 34px;\n    height: 34px;\n\n    border: 1px solid #e5d7cb;\n    border-radius: 50%;\n\n    background: rgba(255,253,250,0.96);\n\n    color: #6f4e39;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    font-size: 24px;\n    line-height: 1;\n\n    cursor: pointer;\n\n    box-shadow:\n      0 3px 12px rgba(60,40,27,0.08);\n\n    transform: translateY(-50%);\n  }\n\n  .hipipet-reviews__arrow--left {\n    left: 12px;\n  }\n\n  .hipipet-reviews__arrow--right {\n    right: 12px;\n  }\n\n  .hipipet-reviews__arrow:hover {\n    background: #f5ebe2;\n  }\n\n\n  /* MOBIL */\n\n  @media screen and (max-width: 749px) {\n\n    .hipipet-reviews {\n      padding: 24px 0 26px;\n    }\n\n    .hipipet-reviews__header {\n      margin-bottom: 15px;\n    }\n\n    .hipipet-reviews__header h2 {\n      font-size: 20px;\n      letter-spacing: -0.2px;\n    }\n\n    .hipipet-reviews__header p {\n      font-size: 11px;\n    }\n\n    .hipipet-reviews__track {\n      gap: 10px;\n\n      padding: 2px 14px 7px;\n\n      scroll-padding-left: 14px;\n    }\n\n    .hipipet-review-card {\n      flex-basis: 310px;\n\n      height: 138px;\n\n      grid-template-columns: 1fr 104px;\n\n      border-radius: 11px;\n    }\n\n    .hipipet-review-card__content {\n      padding: 11px 9px 10px 11px;\n    }\n\n    .hipipet-review-card__top strong {\n      font-size: 11.8px;\n    }\n\n    .hipipet-review-stars {\n      font-size: 9px;\n      margin-top: 3px;\n    }\n\n    .hipipet-review-card__content p {\n      margin: 8px 0 6px;\n\n      font-size: 10.8px;\n      line-height: 1.35;\n    }\n\n    .hipipet-review-verified {\n      font-size: 8.8px;\n    }\n\n    .hipipet-review-card__media {\n      width: 104px;\n      height: 138px;\n    }\n\n    /* Auf Mobilgeräten wischen */\n    .hipipet-reviews__arrow {\n      display: none;\n    }\n\n  }\n\n</style>\n\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n\n    const track = document.getElementById('hipipetReviewsTrack');\n\n    if (!track) return;\n\n    const section = track.closest('.hipipet-reviews');\n\n    const prev =\n      section.querySelector('.hipipet-reviews__arrow--left');\n\n    const next =\n      section.querySelector('.hipipet-reviews__arrow--right');\n\n\n    function getScrollAmount() {\n\n      const card =\n        track.querySelector('.hipipet-review-card');\n\n      if (!card) return 350;\n\n      return card.offsetWidth + 13;\n\n    }\n\n\n    if (next) {\n\n      next.addEventListener('click', function () {\n\n        track.scrollBy({\n          left: getScrollAmount(),\n          behavior: 'smooth'\n        });\n\n      });\n\n    }\n\n\n    if (prev) {\n\n      prev.addEventListener('click', function () {\n\n        track.scrollBy({\n          left: -getScrollAmount(),\n          behavior: 'smooth'\n        });\n\n      });\n\n    }\n\n  });\n</script>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_L7NmrT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign hipipet_story_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/draag_hond_dichtbij_hipipet_DE.png?v=1788510773' %}\n\n<section class=\"hipipet-story\">\n  <div class=\"hipipet-story__inner\">\n\n    <div class=\"hipipet-story__media\">\n      <img\n        src=\"{{ hipipet_story_image }}\"\n        alt=\"HIPIPET Tragegeschirr für kleine Hunde\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"hipipet-story__content\">\n\n      <span class=\"hipipet-story__eyebrow\">\n        HIPIPET · 2-IN-1\n      </span>\n\n      <h2>\n        Laufen, wenn es geht.<br>\n        Tragen, wenn es nötig ist.\n      </h2>\n\n      <p>\n        HIPIPET kombiniert ein bequemes Geschirr mit einer praktischen Tragefunktion.\n        Dein Hund kann ganz normal mitlaufen und wenn er müde wird, hebst du ihn einfach hoch.\n      </p>\n\n      <div class=\"hipipet-story__benefits\">\n\n        <div class=\"hipipet-story__benefit\">\n          <span class=\"hipipet-story__check\">✓</span>\n          <span>Ganz normal beim Spazierengehen verwenden</span>\n        </div>\n\n        <div class=\"hipipet-story__benefit\">\n          <span class=\"hipipet-story__check\">✓</span>\n          <span>Mit einem Handgriff einfach anheben</span>\n        </div>\n\n        <div class=\"hipipet-story__benefit\">\n          <span class=\"hipipet-story__check\">✓</span>\n          <span>Über der Schulter oder in der Hand tragen</span>\n        </div>\n\n      </div>\n\n      <div class=\"hipipet-story__note\">\n        Ideal für kleine Hunde, Welpen und Hunde, die schneller müde werden.\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hipipet-story {\n    width: 100%;\n    box-sizing: border-box;\n    background: #ffffff;\n    padding: 54px 20px;\n  }\n\n  .hipipet-story__inner {\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    align-items: center;\n    gap: 52px;\n  }\n\n  /* BILD */\n  .hipipet-story__media {\n    width: 100%;\n    overflow: hidden;\n\n    background: #faf7f3;\n    border-radius: 18px;\n\n    box-shadow: 0 8px 30px rgba(70, 45, 30, 0.06);\n  }\n\n  .hipipet-story__media img {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: cover;\n  }\n\n  /* TEXT */\n  .hipipet-story__content {\n    width: 100%;\n    max-width: 470px;\n  }\n\n  .hipipet-story__eyebrow {\n    display: inline-flex;\n    align-items: center;\n\n    background: #f5ebe2;\n    color: #8d5d3f;\n\n    border-radius: 999px;\n\n    padding: 6px 11px;\n    margin-bottom: 14px;\n\n    font-size: 11px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.7px;\n  }\n\n  .hipipet-story__content h2 {\n    margin: 0 0 16px;\n\n    color: #2d2723;\n\n    font-size: clamp(30px, 3vw, 44px);\n    line-height: 1.07;\n    font-weight: 700;\n    letter-spacing: -1.1px;\n  }\n\n  .hipipet-story__content > p {\n    margin: 0 0 21px;\n\n    color: #655a52;\n\n    font-size: 14px;\n    line-height: 1.6;\n    font-weight: 500;\n  }\n\n  /* USP'S */\n  .hipipet-story__benefits {\n    display: grid;\n    gap: 9px;\n  }\n\n  .hipipet-story__benefit {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n\n    color: #372f29;\n\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 650;\n  }\n\n  .hipipet-story__check {\n    width: 20px;\n    height: 20px;\n    flex: 0 0 20px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 50%;\n\n    background: #f1e5db;\n    color: #956244;\n\n    font-size: 11px;\n    font-weight: 900;\n  }\n\n  /* HINWEIS UNTEN */\n  .hipipet-story__note {\n    margin-top: 22px;\n    padding: 12px 14px;\n\n    background: #faf7f3;\n    border: 1px solid #eadfd5;\n    border-radius: 10px;\n\n    color: #6d5d51;\n\n    font-size: 11.5px;\n    line-height: 1.45;\n    font-weight: 600;\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 989px) {\n    .hipipet-story__inner {\n      gap: 32px;\n    }\n\n    .hipipet-story__content h2 {\n      font-size: 32px;\n    }\n  }\n\n  /* MOBIL */\n  @media screen and (max-width: 749px) {\n    .hipipet-story {\n      padding: 28px 14px 30px;\n    }\n\n    .hipipet-story__inner {\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .hipipet-story__media {\n      border-radius: 12px;\n    }\n\n    .hipipet-story__content {\n      max-width: none;\n      width: 100%;\n    }\n\n    .hipipet-story__eyebrow {\n      margin-bottom: 10px;\n      padding: 5px 9px;\n\n      font-size: 9.5px;\n    }\n\n    .hipipet-story__content h2 {\n      margin-bottom: 11px;\n\n      font-size: 26px;\n      line-height: 1.08;\n      letter-spacing: -0.6px;\n    }\n\n    .hipipet-story__content > p {\n      margin-bottom: 16px;\n\n      font-size: 12.4px;\n      line-height: 1.5;\n    }\n\n    .hipipet-story__benefits {\n      gap: 7px;\n    }\n\n    .hipipet-story__benefit {\n      gap: 8px;\n\n      font-size: 11.8px;\n      line-height: 1.3;\n    }\n\n    .hipipet-story__check {\n      width: 18px;\n      height: 18px;\n      flex-basis: 18px;\n\n      font-size: 10px;\n    }\n\n    .hipipet-story__note {\n      margin-top: 16px;\n      padding: 10px 11px;\n\n      font-size: 10.8px;\n    }\n  }\n</style>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_HYwVcB": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign hipipet_feature_1_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipetzwart1.png?v=1787632021' %}\n{% assign hipipet_feature_2_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipet2.png?v=1787632021' %}\n{% assign hipipet_feature_3_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/binnenkant_hipipet.png?v=1787753575' %}\n{% assign hipipet_feature_4_image = 'https://cdn.shopify.com/s/files/1/0773/7458/7204/files/hipipetcloseup.png?v=1787632021' %}\n\n<section class=\"hipipet-feature-section\">\n  <div class=\"hipipet-feature-inner\">\n\n    <div class=\"hipipet-feature-header\">\n      <span>INTELLIGENT ENTWORFEN FÜR KLEINE HUNDE</span>\n      <h2>Warum Hundehalter HIPIPET wählen</h2>\n      <p>Entwickelt, um Spazierengehen und Tragen einfacher zu machen.</p>\n    </div>\n\n    <div class=\"hipipet-feature-track\">\n\n      <!-- 1. ANHEBEN -->\n      <article class=\"hipipet-feature-card\">\n        <div class=\"hipipet-feature-media\">\n          {% if hipipet_feature_1_image != blank %}\n            <img\n              src=\"{{ hipipet_feature_1_image }}\"\n              alt=\"HIPIPET - einfaches Anheben\"\n              loading=\"lazy\"\n            >\n          {% else %}\n            <div class=\"hipipet-feature-placeholder\">Foto</div>\n          {% endif %}\n        </div>\n\n        <div class=\"hipipet-feature-content\">\n          <h3>Einfach anheben, wenn dein Hund müde ist</h3>\n\n          <p>\n            Kein umständliches Tragen mehr. Hebe deinen Hund einfach und bequem an, wenn er nicht mehr weiterlaufen möchte oder kann.\n          </p>\n        </div>\n      </article>\n\n      <!-- 2. SPAZIERENGEHEN + TRAGEN -->\n      <article class=\"hipipet-feature-card\">\n        <div class=\"hipipet-feature-media\">\n          <img\n            src=\"{{ hipipet_feature_2_image }}\"\n            alt=\"HIPIPET - Spazierengehen und Tragen in einem\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"hipipet-feature-content\">\n          <h3>Spazierengehen & Tragen in einem</h3>\n\n          <p>\n            Dein Hund kann HIPIPET ganz normal als Geschirr tragen. Wird er müde? Dann trägst du ihn einfach weiter.\n          </p>\n        </div>\n      </article>\n\n      <!-- 3. KOMFORT -->\n      <article class=\"hipipet-feature-card\">\n        <div class=\"hipipet-feature-media\">\n          {% if hipipet_feature_3_image != blank %}\n            <img\n              src=\"{{ hipipet_feature_3_image }}\"\n              alt=\"HIPIPET - bequeme Passform\"\n              loading=\"lazy\"\n            >\n          {% else %}\n            <div class=\"hipipet-feature-placeholder\">Foto</div>\n          {% endif %}\n        </div>\n\n        <div class=\"hipipet-feature-content\">\n          <h3>Bequeme Passform für kleine Hunde</h3>\n\n          <p>\n            Weiche Materialien und eine unterstützende Passform sorgen für angenehmen Komfort beim Spazierengehen und Tragen.\n          </p>\n        </div>\n      </article>\n\n      <!-- 4. STABIL -->\n      <article class=\"hipipet-feature-card\">\n        <div class=\"hipipet-feature-media\">\n          {% if hipipet_feature_4_image != blank %}\n            <img\n              src=\"{{ hipipet_feature_4_image }}\"\n              alt=\"HIPIPET - stabil und sicher unterstützt\"\n              loading=\"lazy\"\n            >\n          {% else %}\n            <div class=\"hipipet-feature-placeholder\">Foto</div>\n          {% endif %}\n        </div>\n\n        <div class=\"hipipet-feature-content\">\n          <h3>Stabil & sicher unterstützt</h3>\n\n          <p>\n            Robuste Gurte, stabile Befestigungen und ein durchdachtes Design für komfortable Nutzung unterwegs.\n          </p>\n        </div>\n      </article>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .hipipet-feature-section {\n    background: #faf7f3;\n    padding: 30px 0;\n    overflow: hidden;\n  }\n\n  .hipipet-feature-inner {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  .hipipet-feature-header {\n    text-align: center;\n    max-width: 720px;\n    margin: 0 auto 22px;\n  }\n\n  .hipipet-feature-header span {\n    display: block;\n    margin-bottom: 7px;\n\n    color: #9A6645;\n    font-size: 10.5px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 1.15px;\n  }\n\n  .hipipet-feature-header h2 {\n    margin: 0 0 8px;\n\n    color: #2D2723;\n    font-size: 28px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: -0.5px;\n  }\n\n  .hipipet-feature-header p {\n    margin: 0;\n\n    color: #655A52;\n    font-size: 13px;\n    line-height: 1.5;\n    font-weight: 500;\n  }\n\n  .hipipet-feature-track {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .hipipet-feature-card {\n    min-width: 0;\n    min-height: 190px;\n\n    display: grid;\n    grid-template-columns: 46% 54%;\n\n    background: #fffdfa;\n    border: 1px solid #eadfd5;\n    border-radius: 12px;\n\n    overflow: hidden;\n\n    box-shadow: 0 4px 14px rgba(70, 45, 30, 0.035);\n  }\n\n  .hipipet-feature-media {\n    min-width: 0;\n    height: 100%;\n    overflow: hidden;\n    background: #f1e7dd;\n  }\n\n  .hipipet-feature-media img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .hipipet-feature-placeholder {\n    width: 100%;\n    height: 100%;\n\n    min-height: 190px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: linear-gradient(\n      135deg,\n      #f4ece5,\n      #eadfd5\n    );\n\n    color: #ae907d;\n    font-size: 11px;\n    font-weight: 700;\n  }\n\n  .hipipet-feature-content {\n    padding: 17px 15px;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  .hipipet-feature-content h3 {\n    margin: 0 0 10px;\n\n    color: #2d2723;\n\n    font-size: 14px;\n    line-height: 1.3;\n    font-weight: 750;\n    letter-spacing: -0.1px;\n  }\n\n  .hipipet-feature-content p {\n    margin: 0;\n\n    color: #655a52;\n\n    font-size: 11.3px;\n    line-height: 1.5;\n    font-weight: 500;\n  }\n\n  @media screen and (max-width: 989px) {\n    .hipipet-feature-track {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hipipet-feature-section {\n      padding: 22px 0;\n    }\n\n    .hipipet-feature-inner {\n      padding: 0;\n    }\n\n    .hipipet-feature-header {\n      padding: 0 18px;\n      margin-bottom: 16px;\n    }\n\n    .hipipet-feature-header span {\n      font-size: 9.2px;\n      margin-bottom: 6px;\n      letter-spacing: 1px;\n    }\n\n    .hipipet-feature-header h2 {\n      font-size: 21px;\n      line-height: 1.2;\n      margin-bottom: 6px;\n      letter-spacing: -0.3px;\n    }\n\n    .hipipet-feature-header p {\n      font-size: 11.5px;\n      line-height: 1.4;\n    }\n\n    .hipipet-feature-track {\n      display: flex;\n\n      gap: 9px;\n\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n\n      padding: 0 14px 7px;\n\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n    }\n\n    .hipipet-feature-track::-webkit-scrollbar {\n      display: none;\n    }\n\n    .hipipet-feature-card {\n      flex: 0 0 305px;\n\n      height: 155px;\n      min-height: 155px;\n\n      grid-template-columns: 43% 57%;\n\n      border-radius: 10px;\n\n      scroll-snap-align: start;\n    }\n\n    .hipipet-feature-placeholder {\n      min-height: 155px;\n    }\n\n    .hipipet-feature-content {\n      padding: 12px 11px;\n    }\n\n    .hipipet-feature-content h3 {\n      margin-bottom: 7px;\n\n      font-size: 12.2px;\n      line-height: 1.25;\n    }\n\n    .hipipet-feature-content p {\n      font-size: 10.3px;\n      line-height: 1.38;\n    }\n  }\n</style>",
