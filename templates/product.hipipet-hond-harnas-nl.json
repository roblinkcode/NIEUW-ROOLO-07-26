    "custom_liquid_k7dg8p": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "{% assign review_1_image = '' %}\n{% assign review_2_image = '' %}\n{% assign review_3_image = '' %}\n{% assign review_4_image = '' %}\n{% assign review_5_image = '' %}\n\n<section class=\"hipipet-reviews\">\n  <div class=\"hipipet-reviews__inner\">\n\n    <div class=\"hipipet-reviews__header\">\n      <span class=\"hipipet-reviews__heart\">♥</span>\n      <h2>Geliefd door baasjes & hun hondjes</h2>\n      <p>Echte ervaringen met HIPIPET</p>\n    </div>\n\n    <div class=\"hipipet-reviews__wrap\">\n\n      <button\n        class=\"hipipet-reviews__arrow hipipet-reviews__arrow--left\"\n        type=\"button\"\n        aria-label=\"Vorige reviews\"\n      >\n        ‹\n      </button>\n\n      <div class=\"hipipet-reviews__track\" id=\"hipipetReviewsTrack\">\n\n        <!-- REVIEW 1 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n            <div class=\"hipipet-review-card__top\">\n              <div>\n                <strong>Sanne & Milo</strong>\n                <div class=\"hipipet-review-stars\">★★★★★</div>\n              </div>\n            </div>\n\n            <p>\n              “Superhandig tijdens langere wandelingen.\n              Als Milo moe wordt, draag ik hem gewoon verder.”\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Geverifieerde aankoop\n            </span>\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n            {% if review_1_image != blank %}\n              <img src=\"{{ review_1_image }}\" alt=\"Sanne & Milo met HIPIPET\" loading=\"lazy\">\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n          </div>\n        </article>\n\n\n        <!-- REVIEW 2 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n            <div class=\"hipipet-review-card__top\">\n              <div>\n                <strong>Lisa & Teddy</strong>\n                <div class=\"hipipet-review-stars\">★★★★★</div>\n              </div>\n            </div>\n\n            <p>\n              “Hij kan er gewoon mee lopen en daarna\n              til ik hem in één beweging op. Echt ideaal.”\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Geverifieerde aankoop\n            </span>\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n            {% if review_2_image != blank %}\n              <img src=\"{{ review_2_image }}\" alt=\"Lisa & Teddy met HIPIPET\" loading=\"lazy\">\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n          </div>\n        </article>\n\n\n        <!-- REVIEW 3 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n            <div class=\"hipipet-review-card__top\">\n              <div>\n                <strong>Emma & Pippa</strong>\n                <div class=\"hipipet-review-stars\">★★★★★</div>\n              </div>\n            </div>\n\n            <p>\n              “Vooral in de stad en onderweg gebruiken\n              we hem vaak. Pippa zit er heel rustig in.”\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Geverifieerde aankoop\n            </span>\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n            {% if review_3_image != blank %}\n              <img src=\"{{ review_3_image }}\" alt=\"Emma & Pippa met HIPIPET\" loading=\"lazy\">\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n          </div>\n        </article>\n\n\n        <!-- REVIEW 4 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n            <div class=\"hipipet-review-card__top\">\n              <div>\n                <strong>Noa & Lou</strong>\n                <div class=\"hipipet-review-stars\">★★★★★</div>\n              </div>\n            </div>\n\n            <p>\n              “Ziet er veel mooier uit dan een gewone\n              hondentas en zit verrassend stevig.”\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Geverifieerde aankoop\n            </span>\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n            {% if review_4_image != blank %}\n              <img src=\"{{ review_4_image }}\" alt=\"Noa & Lou met HIPIPET\" loading=\"lazy\">\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n          </div>\n        </article>\n\n\n        <!-- REVIEW 5 -->\n        <article class=\"hipipet-review-card\">\n          <div class=\"hipipet-review-card__content\">\n            <div class=\"hipipet-review-card__top\">\n              <div>\n                <strong>Sophie & Bo</strong>\n                <div class=\"hipipet-review-stars\">★★★★★</div>\n              </div>\n            </div>\n\n            <p>\n              “De zwarte uitvoering is echt mooi.\n              Voor reizen en de dierenarts perfect.”\n            </p>\n\n            <span class=\"hipipet-review-verified\">\n              ✓ Geverifieerde aankoop\n            </span>\n          </div>\n\n          <div class=\"hipipet-review-card__media\">\n            {% if review_5_image != blank %}\n              <img src=\"{{ review_5_image }}\" alt=\"Sophie & Bo met HIPIPET\" loading=\"lazy\">\n            {% else %}\n              <div class=\"hipipet-review-placeholder\">Foto</div>\n            {% endif %}\n          </div>\n        </article>\n\n      </div>\n\n      <button\n        class=\"hipipet-reviews__arrow hipipet-reviews__arrow--right\"\n        type=\"button\"\n        aria-label=\"Volgende reviews\"\n      >\n        ›\n      </button>\n\n    </div>\n  </div>\n</section>\n\n\n<style>\n  .hipipet-reviews {\n    background: #faf7f3;\n    padding: 32px 0 36px;\n    overflow: hidden;\n  }\n\n  .hipipet-reviews__inner {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  .hipipet-reviews__header {\n    text-align: center;\n    padding: 0 18px;\n    margin-bottom: 20px;\n  }\n\n  .hipipet-reviews__heart {\n    display: block;\n    color: #9a6645;\n    font-size: 15px;\n    line-height: 1;\n    margin-bottom: 6px;\n  }\n\n  .hipipet-reviews__header h2 {\n    margin: 0;\n    color: #2d2723;\n    font-size: 25px;\n    line-height: 1.15;\n    font-weight: 750;\n    letter-spacing: -0.4px;\n  }\n\n  .hipipet-reviews__header p {\n    margin: 5px 0 0;\n    color: #776a61;\n    font-size: 12px;\n    line-height: 1.3;\n  }\n\n  .hipipet-reviews__wrap {\n    position: relative;\n  }\n\n  .hipipet-reviews__track {\n    display: flex;\n    gap: 13px;\n\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n\n    padding: 3px 55px 8px;\n\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .hipipet-reviews__track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .hipipet-review-card {\n    flex: 0 0 355px;\n    height: 155px;\n\n    display: grid;\n    grid-template-columns: 1fr 120px;\n\n    background: #fffdfa;\n    border: 1px solid #eadfd5;\n    border-radius: 13px;\n    overflow: hidden;\n\n    scroll-snap-align: start;\n\n    box-shadow: 0 4px 16px rgba(70, 45, 30, 0.035);\n  }\n\n  .hipipet-review-card__content {\n    padding: 13px 12px 11px 14px;\n\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n  }\n\n  .hipipet-review-card__top strong {\n    display: block;\n    color: #2d2723;\n    font-size: 12.5px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n\n  .hipipet-review-stars {\n    color: #a66d48;\n    letter-spacing: 1px;\n    font-size: 10px;\n    line-height: 1;\n    margin-top: 4px;\n  }\n\n  .hipipet-review-card__content p {\n    margin: 10px 0 8px;\n    color: #4f453e;\n    font-size: 11.6px;\n    line-height: 1.4;\n    font-weight: 500;\n  }\n\n  .hipipet-review-verified {\n    margin-top: auto;\n    color: #8b796d;\n    font-size: 9.5px;\n    line-height: 1;\n    font-weight: 600;\n  }\n\n  .hipipet-review-card__media {\n    width: 120px;\n    height: 155px;\n    overflow: hidden;\n    background: #f0e7de;\n  }\n\n  .hipipet-review-card__media img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .hipipet-review-placeholder {\n    width: 100%;\n    height: 100%;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    color: #b59a87;\n    font-size: 11px;\n    font-weight: 700;\n\n    background:\n      linear-gradient(\n        135deg,\n        #f4ece5,\n        #eadfd5\n      );\n  }\n\n  .hipipet-reviews__arrow {\n    position: absolute;\n    top: 50%;\n    z-index: 5;\n\n    width: 34px;\n    height: 34px;\n\n    border: 1px solid #e5d7cb;\n    border-radius: 50%;\n\n    background: rgba(255, 253, 250, 0.96);\n    color: #6f4e39;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    font-size: 24px;\n    line-height: 1;\n\n    cursor: pointer;\n\n    box-shadow: 0 3px 12px rgba(60, 40, 27, 0.08);\n\n    transform: translateY(-50%);\n  }\n\n  .hipipet-reviews__arrow--left {\n    left: 12px;\n  }\n\n  .hipipet-reviews__arrow--right {\n    right: 12px;\n  }\n\n  .hipipet-reviews__arrow:hover {\n    background: #f5ebe2;\n  }\n\n\n  @media screen and (max-width: 749px) {\n\n    .hipipet-reviews {\n      padding: 24px 0 26px;\n    }\n\n    .hipipet-reviews__header {\n      margin-bottom: 15px;\n    }\n\n    .hipipet-reviews__header h2 {\n      font-size: 20px;\n      letter-spacing: -0.2px;\n    }\n\n    .hipipet-reviews__header p {\n      font-size: 11px;\n    }\n\n    .hipipet-reviews__track {\n      gap: 10px;\n      padding: 2px 14px 7px;\n      scroll-padding-left: 14px;\n    }\n\n    .hipipet-review-card {\n      flex-basis: 310px;\n      height: 138px;\n\n      grid-template-columns: 1fr 104px;\n\n      border-radius: 11px;\n    }\n\n    .hipipet-review-card__content {\n      padding: 11px 9px 10px 11px;\n    }\n\n    .hipipet-review-card__top strong {\n      font-size: 11.8px;\n    }\n\n    .hipipet-review-stars {\n      font-size: 9px;\n      margin-top: 3px;\n    }\n\n    .hipipet-review-card__content p {\n      margin: 8px 0 6px;\n\n      font-size: 10.8px;\n      line-height: 1.35;\n    }\n\n    .hipipet-review-verified {\n      font-size: 8.8px;\n    }\n\n    .hipipet-review-card__media {\n      width: 104px;\n      height: 138px;\n    }\n\n    /* Op mobiel gewoon swipen */\n    .hipipet-reviews__arrow {\n      display: none;\n    }\n  }\n</style>\n\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const track = document.getElementById('hipipetReviewsTrack');\n\n    if (!track) return;\n\n    const section = track.closest('.hipipet-reviews');\n    const prev = section.querySelector('.hipipet-reviews__arrow--left');\n    const next = section.querySelector('.hipipet-reviews__arrow--right');\n\n    function getScrollAmount() {\n      const card = track.querySelector('.hipipet-review-card');\n\n      if (!card) return 350;\n\n      return card.offsetWidth + 13;\n    }\n\n    if (next) {\n      next.addEventListener('click', function () {\n        track.scrollBy({\n          left: getScrollAmount(),\n          behavior: 'smooth'\n        });\n      });\n    }\n\n    if (prev) {\n      prev.addEventListener('click', function () {\n        track.scrollBy({\n          left: -getScrollAmount(),\n          behavior: 'smooth'\n        });\n      });\n    }\n  });\n</script>",
