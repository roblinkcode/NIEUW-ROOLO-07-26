    "ss_simple_faq_czzL8H": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_QXBxNA": {
          "type": "text",
          "settings": {
            "question": "Zijn de jassen waterdicht?",
            "answer": "<p>Onze jassen hebben een waterafstotende buitenlaag die lichte regen en sneeuw buiten houdt. Ze bieden een zeer goede bescherming tegen vocht.</p>"
          }
        },
        "text_ACHFh9": {
          "type": "text",
          "settings": {
            "question": "Kan de jas in de wasmachine?",
            "answer": "<p>Ja, je kan de jas wassen in de wasmachine. Volg de wasinstructies op het etiket om een optimale verzorging te garanderen.</p>"
          }
        },
        "text_PmBwJT": {
          "type": "text",
          "settings": {
            "question": "Zijn de jassen geschikt voor alle hondenrassen?",
            "answer": "<p>Onze jassen zijn verkrijgbaar in verschillende maten en passen op de meeste hondenrassen. Bekijk goed de maattabel om de juiste maat voor jouw hond te kiezen.</p>"
          }
        },
        "text_wFgwJW": {
          "type": "text",
          "settings": {
            "question": "Is de jas ook geschikt voor katten?",
            "answer": "<p>Ja zeker, de jas past ook bij katten, zolang het overeenkomt met de maattabel moet de jas goed passen!</p>"
          }
        },
        "text_A6dJBC": {
          "type": "text",
          "settings": {
            "question": "Kan ik mijn bestelling retourneren als ik niet tevreden ben?",
            "answer": "<p>Geen probleem! Neem binnen 30 dagen na ontvangst van de jas contact op met onze klantenservice.</p>"
          }
        }
      },
      "block_order": [
        "text_QXBxNA",
