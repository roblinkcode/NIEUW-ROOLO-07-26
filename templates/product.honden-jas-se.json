    "ss_simple_faq_czzL8H": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_QXBxNA": {
          "type": "text",
          "settings": {
            "question": "Är jackorna vattentäta?",
            "answer": "<p>Våra jackor har ett vattenavvisande ytterlager som håller lätt regn och snö ute. De ger ett mycket bra skydd mot fukt.</p>"
          }
        },
        "text_ACHFh9": {
          "type": "text",
          "settings": {
            "question": "Kan jackan tvättas i tvättmaskin?",
            "answer": "<p>Ja, jackan kan tvättas i tvättmaskin. Följ tvättråden på etiketten för bästa möjliga skötsel.</p>"
          }
        },
        "text_PmBwJT": {
          "type": "text",
          "settings": {
            "question": "Passar jackorna alla hundraser?",
            "answer": "<p>Våra jackor finns i flera storlekar och passar de flesta hundraser. Läs storleksguiden noggrant för att välja rätt storlek till din hund.</p>"
          }
        },
        "text_wFgwJW": {
          "type": "text",
          "settings": {
            "question": "Passar jackan även katter?",
            "answer": "<p>Ja, jackan passar även katter. Så länge måtten stämmer med storleksguiden bör den sitta bra!</p>"
          }
        },
        "text_A6dJBC": {
          "type": "text",
          "settings": {
            "question": "Kan jag returnera min beställning om jag inte är nöjd?",
            "answer": "<p>Självklart! Kontakta vår kundservice inom 30 dagar efter att du har fått jackan.</p>"
          }
        }
      },
      "block_order": [
        "text_QXBxNA",
        "text_ACHFh9",
