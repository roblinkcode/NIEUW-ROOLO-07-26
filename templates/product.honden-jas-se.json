        "custom_liquid_D3RWQ8": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"dogjacket-purchase-line\">\n  <div class=\"dogjacket-photo-group\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0773/7458/7204/files/Scherm_afbeelding_2026-08-25_om_06.55.24.png?v=1787633744\"\n      alt=\"Dog Jacket-kund\"\n      class=\"dogjacket-photo\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0773/7458/7204/files/Scherm_afbeelding_2026-08-25_om_06.56.07.png?v=1787633777\"\n      alt=\"Dog Jacket-kund\"\n      class=\"dogjacket-photo\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0773/7458/7204/files/Scherm_afbeelding_2026-08-25_om_06.56.56.png?v=1787633825\"\n      alt=\"Dog Jacket-kund\"\n      class=\"dogjacket-photo\"\n      loading=\"lazy\"\n    >\n  </div>\n\n  <div class=\"dogjacket-purchase-text\">\n    <span class=\"dogjacket-buyer-name\">Eva</span>\n\n    <span class=\"dogjacket-verified\" aria-label=\"Verifierad\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path\n          class=\"dogjacket-verified-shape\"\n          d=\"M22.25 12c0 1.05-1.28 1.9-1.59 2.84-.32.98.22 2.4-.37 3.2-.59.82-2.1.73-2.91 1.32-.8.58-1.18 2.05-2.16 2.37-.94.3-2.11-.61-3.16-.61s-2.22.92-3.16.61c-.98-.32-1.36-1.79-2.16-2.37-.82-.59-2.32-.5-2.91-1.32-.59-.8-.05-2.22-.37-3.2C3.15 13.9 1.87 13.05 1.87 12s1.28-1.9 1.59-2.84c.32-.98-.22-2.4.37-3.2.59-.82 2.1-.73 2.91-1.32.8-.58 1.18-2.05 2.16-2.37.94-.3 2.11.61 3.16.61s2.22-.92 3.16-.61c.98.32 1.36 1.79 2.16 2.37.82.59 2.32.5 2.91 1.32.59.8.05 2.22.37 3.2.31.94 1.59 1.79 1.59 2.84z\"\n        ></path>\n\n        <path\n          class=\"dogjacket-verified-check\"\n          d=\"M7.4 12.2l3 3.1 6.4-6.7\"\n        ></path>\n      </svg>\n    </span>\n\n    <span>\n      och över <b>2 000</b> andra valde Dog Jacket\n    </span>\n  </div>\n</div>\n\n<style>\n  .dogjacket-purchase-line {\n    display: flex;\n    align-items: center;\n    width: 100%;\n    box-sizing: border-box;\n\n    background: transparent;\n    border: none;\n    box-shadow: none;\n\n    padding: 4px 0;\n    margin: 8px 0 12px;\n\n    color: #2D2723;\n  }\n\n  .dogjacket-photo-group {\n    display: inline-flex;\n    align-items: center;\n    margin-right: 10px;\n    flex-shrink: 0;\n  }\n\n  .dogjacket-photo {\n    width: 25px;\n    height: 25px;\n    object-fit: cover;\n    border-radius: 50%;\n\n    border: 2px solid #FFFFFF;\n    margin-left: -7px;\n\n    box-shadow: 0 2px 5px rgba(70, 45, 30, 0.12);\n  }\n\n  .dogjacket-photo:first-child {\n    margin-left: 0;\n  }\n\n  .dogjacket-purchase-text {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 3px;\n\n    font-size: 12px;\n    font-weight: 500;\n    line-height: 1.3;\n\n    color: #62574F;\n  }\n\n  .dogjacket-buyer-name {\n    font-weight: 800;\n    color: #2D2723;\n  }\n\n  .dogjacket-purchase-text b {\n    color: #2D2723;\n    font-weight: 800;\n  }\n\n  .dogjacket-verified {\n    width: 17px;\n    height: 17px;\n    flex: 0 0 17px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .dogjacket-verified svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n\n  .dogjacket-verified-shape {\n    fill: #1D9BF0;\n  }\n\n  .dogjacket-verified-check {\n    fill: none;\n    stroke: #FFFFFF;\n    stroke-width: 2.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  @media screen and (max-width: 480px) {\n    .dogjacket-purchase-line {\n      padding: 3px 0;\n      margin: 7px 0 10px;\n    }\n\n    .dogjacket-photo-group {\n      margin-right: 8px;\n    }\n\n    .dogjacket-photo {\n      width: 23px;\n      height: 23px;\n      margin-left: -6px;\n    }\n\n    .dogjacket-purchase-text {\n      font-size: 11.3px;\n      line-height: 1.25;\n      gap: 3px;\n    }\n\n    .dogjacket-verified {\n      width: 16px;\n      height: 16px;\n      flex-basis: 16px;\n    }\n  }\n</style>"
          }
        },
        "custom_liquid_8e6nKj": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign klarna_part = current_variant.price | divided_by: 3 %}\n\n<div class=\"hipipet-trust-list\">\n\n  <!-- Fri frakt -->\n  <div class=\"hipipet-trust-row\">\n    <div class=\"hipipet-trust-icon\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M3 6.5h11v9H3z\"></path>\n        <path d=\"M14 9h3.2l2.3 2.8v3.7H14z\"></path>\n        <circle cx=\"7\" cy=\"17.5\" r=\"1.6\"></circle>\n        <circle cx=\"17.5\" cy=\"17.5\" r=\"1.6\"></circle>\n      </svg>\n    </div>\n\n    <div class=\"hipipet-trust-text\">\n      Fri frakt – se villkor\n    </div>\n  </div>\n\n\n  <!-- 30 dagars returrätt -->\n  <div class=\"hipipet-trust-row\">\n    <div class=\"hipipet-trust-icon\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M12 7v5l3 2\"></path>\n        <circle cx=\"12\" cy=\"12\" r=\"8\"></circle>\n      </svg>\n    </div>\n\n    <div class=\"hipipet-trust-text\">\n      30 dagars returrätt\n    </div>\n  </div>\n\n\n  <!-- Klarna -->\n  <div class=\"hipipet-trust-row\">\n    <div class=\"hipipet-klarna-icon\">\n      Klarna\n    </div>\n\n    <div class=\"hipipet-trust-text\">\n      Betala i 3 delbetalningar på\n      <strong id=\"hipipet-klarna-price\">\n        {{ klarna_part | money }}\n      </strong>.\n      Räntefritt.\n    </div>\n  </div>\n\n</div>\n\n\n<script type=\"application/json\" id=\"hipipet-product-variants\">\n  {{ product.variants | json }}\n</script>\n\n\n<style>\n  .hipipet-trust-list {\n    display: grid;\n    gap: 8px;\n    width: 100%;\n    margin: 11px 0 15px;\n  }\n\n  .hipipet-trust-row {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 32px;\n  }\n\n  .hipipet-trust-icon {\n    width: 38px;\n    height: 30px;\n    flex: 0 0 38px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: #F4EBDD;\n    border-radius: 5px;\n  }\n\n  .hipipet-trust-icon svg {\n    width: 17px;\n    height: 17px;\n\n    fill: none;\n    stroke: #4A382C;\n    stroke-width: 1.6;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .hipipet-klarna-icon {\n    width: 38px;\n    height: 30px;\n    flex: 0 0 38px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    background: #FFB3C7;\n    color: #111111;\n\n    border-radius: 5px;\n\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: -0.2px;\n  }\n\n  .hipipet-trust-text {\n    color: #342B25;\n    font-size: 12.8px;\n    font-weight: 500;\n    line-height: 1.3;\n  }\n\n  .hipipet-trust-text strong {\n    color: #211B17;\n    font-weight: 800;\n  }\n\n  @media screen and (max-width: 749px) {\n    .hipipet-trust-list {\n      gap: 6px;\n      margin: 9px 0 12px;\n    }\n\n    .hipipet-trust-row {\n      gap: 9px;\n      min-height: 29px;\n    }\n\n    .hipipet-trust-icon,\n    .hipipet-klarna-icon {\n      width: 35px;\n      height: 28px;\n      flex-basis: 35px;\n    }\n\n    .hipipet-trust-icon svg {\n      width: 16px;\n      height: 16px;\n    }\n\n    .hipipet-trust-text {\n      font-size: 12.2px;\n      line-height: 1.25;\n    }\n\n    .hipipet-klarna-icon {\n      font-size: 7.5px;\n    }\n  }\n</style>\n\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const variantsEl = document.getElementById('hipipet-product-variants');\n    const klarnaPriceEl = document.getElementById('hipipet-klarna-price');\n\n    if (!variantsEl || !klarnaPriceEl) return;\n\n    const variants = JSON.parse(variantsEl.textContent);\n    const marketCurrency = {{ localization.country.currency.iso_code | json }};\n\n    function formatMoney(cents) {\n      return new Intl.NumberFormat('sv-SE', {\n        style: 'currency',\n        currency: marketCurrency\n      }).format(cents / 100);\n    }\n\n    function updateKlarnaPrice() {\n      const variantInput = document.querySelector(\n        'form[action*=\"/cart/add\"] input[name=\"id\"]'\n      );\n\n      if (!variantInput) return;\n\n      const variantId = Number(variantInput.value);\n\n      const variant = variants.find(function (v) {\n        return Number(v.id) === variantId;\n      });\n\n      if (!variant) return;\n\n      const installmentPrice = variant.price / 3;\n\n      klarnaPriceEl.textContent = formatMoney(installmentPrice);\n    }\n\n    updateKlarnaPrice();\n\n    document.addEventListener('change', function () {\n      setTimeout(updateKlarnaPrice, 50);\n    });\n\n    const variantInput = document.querySelector(\n      'form[action*=\"/cart/add\"] input[name=\"id\"]'\n    );\n\n    if (variantInput) {\n      const observer = new MutationObserver(function () {\n        updateKlarnaPrice();\n      });\n\n      observer.observe(variantInput, {\n        attributes: true,\n        attributeFilter: ['value']\n      });\n    }\n  });\n</script>"
          }
        },
