            "caption_2": "Zwart / Oranje Rand",
            "image_3_fallback": "orange-fixings",
            "image_3_alt": "Zwart / Oranje Bevestigingen",
            "show_image_3": true,
            "caption_3": "Zwart / Oranje Bevestigingen"
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "visible": true,
            "title": "Kan ik de autogordels blijven gebruiken?",
            "body": "<p>De beschermer heeft gordelopeningen. Controleer of die aansluiten op jouw auto. PawGuard vervangt geen veiligheidstuig of autogordel voor je hond.</p>",
            "show_colors": false
          }
        },
        "faq_7": {
          "type": "question",
          "settings": {
            "visible": true,
            "title": "Hoe zit het met verzending en retourneren?",
            "body": "<p><a href=\"/policies/shipping-policy\">Bekijk ons verzendbeleid</a>. <a href=\"/policies/refund-policy\">Lees de voorwaarden voor retourneren</a>. Neem bij vragen <a href=\"/pages/contact\">contact met ons op</a>.</p>",
            "show_colors": false
          }
        }
