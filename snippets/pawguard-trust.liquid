{% comment %}Shipping and 30-day return copy checked against roolo.nl policies on 2026-10-29.{% endcomment %}
<div class="pawguard-trust">
  <div class="pawguard-trust-row">
    <span class="pawguard-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6.5h11v9H3zM14 9h3.2l2.3 2.8v3.7H14z"></path><circle cx="7" cy="17.5" r="1.6"></circle><circle cx="17.5" cy="17.5" r="1.6"></circle></svg></span>
    <div class="pawguard-trust-text"><a href="{{ shop.shipping_policy.url }}">Gratis verzending vanaf €20</a></div>
  </div>
  <div class="pawguard-trust-row">
    <span class="pawguard-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 7v5l3 2"></path><circle cx="12" cy="12" r="8"></circle></svg></span>
    <div class="pawguard-trust-text"><a href="{{ shop.refund_policy.url }}">30 dagen retourgarantie</a></div>
  </div>
  {% if localization.country.iso_code == 'NL' and cart.currency.iso_code == 'EUR' and shop.enabled_payment_types contains 'klarna' %}
    {% liquid
      assign current_variant = product.selected_or_first_available_variant
      assign quantity = current_variant.quantity_rule.min | default: 1
      assign unit_price = current_variant.price
      for price_break in current_variant.quantity_price_breaks
        if quantity >= price_break.minimum_quantity
          assign unit_price = price_break.price
        endif
      endfor
      assign initial_total = unit_price | times: quantity
    %}
    <pawguard-installments class="pawguard-installments" data-section="{{ section.id }}" data-variant="{{ current_variant.id }}" data-currency="{{ cart.currency.iso_code }}">
      <div class="pawguard-trust-row">
        <span class="pawguard-klarna-icon">{{ 'klarna' | payment_type_svg_tag }}</span>
        <div class="pawguard-trust-text">Betaal in 3 termijnen van circa <strong data-installment aria-live="polite" aria-atomic="true">{{ initial_total | divided_by: 3.0 | round | money }}</strong>. Rentevrij.</div>
      </div>
      <small class="pawguard-installments-note">Indicatief. Beschikbaarheid en definitieve termijnverdeling worden door Klarna bepaald bij het afrekenen.</small>
      <script type="application/json">{
        {% for variant in product.variants %}
          "{{ variant.id }}": {
            "price": {{ variant.price | json }},
            "minimum": {{ variant.quantity_rule.min | default: 1 | json }},
            "breaks": [{% for price_break in variant.quantity_price_breaks %}{"minimum": {{ price_break.minimum_quantity | json }}, "price": {{ price_break.price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }</script>
    </pawguard-installments>
  {% endif %}
</div>
