{% if template.suffix == 'hond-achterbank-bescherme' and section.settings.visible %}
{{ 'pawguard.css' | asset_url | stylesheet_tag }}
{% render 'pawguard-section-style', section: section %}
<section class="pawguard-section"><div class="pawguard-faq"><header class="pawguard-heading">{% if section.settings.eyebrow != blank %}<p class="pawguard-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.title != blank %}<h2>{{ section.settings.title | escape }}</h2>{% endif %}</header>
      {% for block in section.blocks %}{% if block.settings.visible %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary>{{ block.settings.body }}{% if block.settings.show_colors %}<div class="pawguard-colors"><figure>{% if block.settings.show_image_1 %}{% render 'pawguard-editor-image', selected: block.settings.image_1, fallback: block.settings.image_1_fallback, alt: block.settings.image_1_alt %}{% endif %}<figcaption>{{ block.settings.caption_1 | escape }}</figcaption></figure><figure>{% if block.settings.show_image_2 %}{% render 'pawguard-editor-image', selected: block.settings.image_2, fallback: block.settings.image_2_fallback, alt: block.settings.image_2_alt %}{% endif %}<figcaption>{{ block.settings.caption_2 | escape }}</figcaption></figure><figure>{% if block.settings.show_image_3 %}{% render 'pawguard-editor-image', selected: block.settings.image_3, fallback: block.settings.image_3_fallback, alt: block.settings.image_3_alt %}{% endif %}<figcaption>{{ block.settings.caption_3 | escape }}</figcaption></figure></div>{% endif %}</details>{% endif %}{% endfor %}
    </div></section>
{% endif %}
